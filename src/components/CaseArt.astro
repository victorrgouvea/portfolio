---
import { Image } from 'astro:assets';
import robot from '../assets/cases/smartzap-avatar.png';
import beatfitHome from '../assets/cases/beatfit-1.png';
import beatfitSetup from '../assets/cases/beatfit-3.png';
import fintzLogo from '../assets/cases/fintz-logo.png';

interface Props {
  id: 'deepdive' | 'ventiur' | 'smartzap' | 'beatfit' | 'fintz';
  art: Record<string, string>;
}
const { id, art } = Astro.props;
const lines = (n: number, hot: number[] = []) =>
  Array.from({ length: n }, (_, i) => ({ w: 55 + ((i * 37) % 45), hot: hot.includes(i) }));
---

{
  id === 'deepdive' && (
    <div class="art art-dd">
      <div class="art-dd__in">
        <div class="art-dd__pages">
          {[0, 1, 2, 3].map((i) => (
            <div class="sheet" style={`--i:${i}`}>
              {i === 3 && <b class="sheet__tag">PDF</b>}
              {lines(9, i === 3 ? [2, 5, 6] : []).map((l) => (
                <i class:list={[{ hot: l.hot }]} style={`width:${l.w}%`} />
              ))}
            </div>
          ))}
        </div>
      </div>
      <ol class="art-dd__steps">
        <li>{art.a}</li>
        <li>{art.b}</li>
        <li>{art.c}</li>
        <li>{art.d}</li>
      </ol>
      <div class="art-dd__out">
        <div class="doc">
          <p class="doc__title">
            <b>DOCX</b>
            {art.report}
          </p>
          {[art.h1, art.h2, art.h3].map((h, i) => (
            <div class="doc__sec">
              <p>
                <span>{i + 1}</span>
                {h}
              </p>
              <i style={`width:${92 - i * 9}%`} />
              <i style={`width:${70 + i * 8}%`} />
            </div>
          ))}
        </div>
        <div class="xls">
          <p class="xls__title">
            <b>XLSX</b>
            {art.sheet}
          </p>
          <div class="xls__grid">
            <span>{art.c1}</span>
            <span>{art.c2}</span>
            <span>{art.c3}</span>
            {[
              [78, 40, 62],
              [60, 55, 48],
              [86, 40, 70],
              [52, 62, 44],
            ].map((row) => row.map((w, c) => <i class:list={[{ num: c === 2 }]} style={`--w:${w}%`} />))}
          </div>
        </div>
      </div>
    </div>
  )
}

{
  id === 'ventiur' && (
    <div class="art art-vt">
      <div class="art-vt__bar">
        <span class="art-vt__search">{art.search}</span>
        <span class="art-vt__count">{art.count}</span>
      </div>
      <div class="art-vt__chips">
        <span>{art.f1}</span>
        <span class="on">{art.f2}</span>
        <span>{art.f3}</span>
      </div>
      <ul class="art-vt__rows">
        {[62, 48, 71, 40, 56].map((w, i) => (
          <li>
            <b style={`width:${w}%`} />
            <i style={`width:${90 - w / 2}%`} />
            {i === 1 && <em>{art.edited}</em>}
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  id === 'smartzap' && (
    <div class="art art-sz">
      <div class="chat">
        <div class="chat__head">
          <Image class="chat__avatar" src={robot} alt="" width={112} height={112} />
          <div>
            <p class="chat__name">SmartZap</p>
            <p class="chat__status">{art.status}</p>
          </div>
        </div>
        <div class="chat__body">
          <div class="msg msg--me msg--audio">
            <span class="msg__play" />
            <span class="msg__wave">
              {[5, 9, 14, 8, 12, 16, 10, 6, 13, 9, 15, 7, 11, 5, 9, 13, 8, 4].map((h) => (
                <i style={`height:${h}px`} />
              ))}
            </span>
            <span class="msg__time">{art.audio}</span>
          </div>
          <p class="msg msg--me">
            {art.u1}
            <span class="msg__time">09:41</span>
          </p>
          <p class="msg">
            {art.b1}
            <span class="msg__time">09:41</span>
          </p>
          <p class="msg msg--me">
            {art.u2}
            <span class="msg__time">09:42</span>
          </p>
          <p class="msg">
            {art.b2}
            <span class="msg__time">09:42</span>
          </p>
        </div>
        <div class="chat__input">
          <span>{art.input}</span>
          <i />
        </div>
      </div>
    </div>
  )
}

{
  id === 'beatfit' && (
    <div class="art art-bf">
      <Image class="shot shot--a" src={beatfitHome} alt={art.alt} width={480} />
      <Image class="shot shot--b" src={beatfitSetup} alt="" width={480} />
    </div>
  )
}

{
  id === 'fintz' && (
    <div class="art art-fz">
      <div class="api">
        <p class="api__brand">
          <Image src={fintzLogo} alt="" width={56} height={56} />
          <span>fintz</span>
        </p>
        <dl>
          <dt>{art.g1}</dt>
          <dd>{art.e1}</dd>
          <dd>{art.e2}</dd>
          <dd>{art.e3}</dd>
          <dt>{art.g2}</dt>
          <dd>{art.e4}</dd>
          <dt>{art.g3}</dt>
          <dd>{art.e5}</dd>
        </dl>
      </div>
      <ol>
        <li>{art.a}</li>
        <li>{art.b}</li>
        <li class="on">{art.c}</li>
        <li>{art.d}</li>
        <li class="on">{art.e}</li>
        <li>{art.f}</li>
      </ol>
    </div>
  )
}
