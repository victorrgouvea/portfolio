---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { content, EMAIL, GITHUB, LINKEDIN, type Lang } from '../i18n/content';
import CaseArt from './CaseArt.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
// Every internal path goes through `url` so the site works under a base path too.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => base + path;
const home = url(lang === 'en' ? '/' : '/pt/');
const other = url(lang === 'en' ? '/pt/' : '/');
const site = Astro.site!;
const cvHref = url(t.contact.cvHref);
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={new URL(home, site)} />
    <link rel="alternate" hreflang="en" href={new URL(url('/'), site)} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(url('/pt/'), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(url('/'), site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={new URL(home, site)} />
    <meta name="theme-color" content="#e9ecf2" />
  </head>
  <body>
    <a class="skip" href="#work">{t.hero.ctaWork}</a>

    <header class="nav" data-nav>
      <nav class="nav__links" aria-label="Primary">
        <a href="#work">{t.nav.work}</a>
        <a href="#experience">{t.nav.experience}</a>
        <a href="#skills">{t.nav.skills}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>
      <a class="nav__lang" href={other} hreflang={lang === 'en' ? 'pt-BR' : 'en'} aria-label={t.nav.switchLabel} data-lang-switch>
        <span aria-hidden="true" class:list={[{ on: lang === 'en' }]}>EN</span>
        <span aria-hidden="true" class:list={[{ on: lang === 'pt' }]}>PT</span>
      </a>
    </header>

    <main>
      <section class="hero" data-hero>
        <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
        <h1 class="hero__name" data-hero-name aria-label="Victor Gouvêa">
          <span class="hero__line"><span data-chunk>Vic</span><span data-chunk>tor</span></span>
          <span class="hero__line"><span data-chunk>Gou</span><span data-chunk>vêa</span></span>
        </h1>
        <div class="hero__foot">
          <p class="hero__lede">{t.hero.lede}</p>
          <div class="hero__side">
            <div class="hero__meta">
              <p class="hero__role">{t.hero.role}</p>
              <p>{t.hero.place}</p>
            </div>
            <div class="hero__cta">
              <a class="btn btn--solid" href="#work">{t.hero.ctaWork}</a>
              <a class="btn" href={cvHref} download>{t.hero.ctaCv}</a>
              <a class="btn btn--icon" href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
              </a>
              <a class="btn btn--icon" href={LINKEDIN} target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="statement" aria-label={t.meta.description}>
        {
          t.statement.map((para) => (
            <p>
              {para.map((frag) =>
                typeof frag === 'string' ? frag : <mark data-mark>{frag.mark}</mark>,
              )}
            </p>
          ))
        }
      </section>

      <section class="work" id="work">
        <div class="section-head section-head--dark">
          <h2>{t.work.title}</h2>
          <p>{t.work.intro}</p>
        </div>
        <div class="cases">
          {
            t.cases.map((c) => (
              <article class={`case case--${c.id}`}>
                <div class="case__inner">
                  <div class="case__text">
                    <p class="case__kind">
                      <span>{c.kind}</span>
                      <span>{c.years}</span>
                    </p>
                    <h3 class="case__name">{c.name}</h3>
                    <p class="case__summary">{c.summary}</p>
                    <ul class="case__points">
                      {c.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                    <dl class="case__facts">
                      <div>
                        <dt>{t.work.roleLabel}</dt>
                        <dd>{c.role}</dd>
                      </div>
                      <div>
                        <dt>{t.work.stackLabel}</dt>
                        <dd>{c.stack.join(', ')}</dd>
                      </div>
                    </dl>
                  </div>
                  <div class="case__art" aria-hidden="true">
                    <CaseArt id={c.id} art={c.art} />
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="more" id="more">
        <div class="section-head">
          <h2>{t.more.title}</h2>
          <p>{t.more.intro}</p>
        </div>
        {
          t.more.groups.map((g) => (
            <div class="more__group">
              <h3>{g.name}</h3>
              <ul class="rows">
                {g.items.map((it) => (
                  <li class="row">
                    <span class="row__name">
                      {it.href ? (
                        <a href={it.href} target="_blank" rel="noopener">
                          {it.name}
                        </a>
                      ) : (
                        it.name
                      )}
                    </span>
                    <span class="row__what">{it.what}</span>
                    <span class="row__stack">{it.stack}</span>
                    <span class="row__year">{it.year}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <p class="more__foot">
          {t.more.footnote}
          <a href="https://codevon.com/portfolio" target="_blank" rel="noopener">codevon.com/portfolio</a>.
        </p>
      </section>

      <section class="xp" id="experience">
        <div class="section-head">
          <h2>{t.experience.title}</h2>
        </div>
        <ol class="xp__list">
          {
            t.experience.jobs.map((j) => (
              <li class="xp__item">
                <p class="xp__period">{j.period}</p>
                <div>
                  <h3>{j.company}</h3>
                  <p class="xp__role">
                    {j.role}, {j.place}
                  </p>
                  <ul>
                    {j.body.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
          <li class="xp__item">
            <p class="xp__period">{t.experience.education.period}</p>
            <div>
              <h3>{t.experience.education.school}</h3>
              <p class="xp__role">
                {t.experience.educationTitle}: {t.experience.education.degree}
              </p>
            </div>
          </li>
        </ol>
      </section>

      <section class="skills" id="skills">
        <div class="section-head">
          <h2>{t.skills.title}</h2>
        </div>
        <div class="skills__grid">
          {
            t.skills.groups.map((g) => (
              <div>
                <h3>{g.name}</h3>
                <ul>
                  {g.items.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="skills__gh">
          <a href={GITHUB} target="_blank" rel="noopener">{t.skills.github}</a>
        </p>
      </section>

      <section class="contact" id="contact">
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="contact__mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <ul class="contact__links">
          <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={GITHUB} target="_blank" rel="noopener">GitHub</a></li>
          <li><a href={cvHref} download>{t.contact.cv}</a></li>
        </ul>
        <p class="contact__foot">{t.footer}</p>
      </section>
    </main>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
